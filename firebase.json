{
  "hosting": {
    "site": "yoyochampion-671fe",
    "public": "apps/next/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|avif|js|css|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      }
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "config/firebase/firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8287
    },
    "auth": {
      "port": 9287
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "hosting": {
      "port": 5287
    }
  }
}
